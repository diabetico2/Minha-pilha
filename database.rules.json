{
  "rules": {
    ".read": false,
    ".write": false,
    "piles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "read": {
          "$key": {
            ".validate": "newData.isBoolean()"
          },
          ".validate": "newData.hasChildren()"
        },
        "favoriteOrders": {
          "$key": {
            ".validate": "newData.isBoolean()"
          },
          ".validate": "newData.hasChildren()"
        },
        "queueOrders": {
          "$key": {
            ".validate": "newData.isBoolean()"
          },
          ".validate": "newData.hasChildren()"
        },
        "current": {
          "$key": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          ".validate": "newData.hasChildren()"
        },
        "notes": {
          "$key": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          },
          ".validate": "newData.hasChildren()"
        },
        "completedAt": {
          "$key": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          ".validate": "newData.hasChildren()"
        },
        "customOrders": {
          "$key": {
            ".validate": "newData.isString() && newData.val().length <= 200000"
          },
          ".validate": "newData.hasChildren()"
        },
        "profile": {
          "646973706c61794e616d65": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "62696f": { ".validate": "newData.isString() && newData.val().length <= 280" },
          "617661746172": { ".validate": "newData.isString() && newData.val().length <= 32000 && (newData.val() === '' || newData.val().matches(/^data:image\\/(jpeg|png|webp);base64,[A-Za-z0-9+\\/]+={0,2}$/))" },
          "$other": { ".validate": false },
          ".validate": "newData.hasChildren()"
        },
        "$other": {
          ".validate": false
        },
        ".validate": "newData.hasChildren()"
      }
    }
  }
}
